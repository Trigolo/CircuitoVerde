# Copie este arquivo para ".env" e preencha com os seus dados
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_a_senha_do_root_aqui
DB_NAME=circuitoverde

# Qualquer texto longo e secreto (usado para assinar o token de login)
JWT_SECRET=troque-isto-por-um-texto-longo-e-secreto

# Assistente virtual (opcional). Sem chave, o chat responde com o bot por regras.
# Crie a chave grátis em https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
